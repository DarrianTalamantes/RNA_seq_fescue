library(data.table)
library(ggplot2)
library(tidyverse)
####### set common directories  ###########
diversity_data <- "/home/darrian/Documents/Diversity_Population/Data/Diversity_Analysis/"
data_dir <- "/home/darrian/Documents/Diversity_Population/Data/"
################################################################################
# plotting Pi (nucleotide diversity) across genome
################################################################################
# load in data
nuc_div <- fread(paste0(diversity_data,"diversity_results.windowed.pi"), header=TRUE)
nuc_div <- nuc_div %>% filter(grepl("FaChr", CHROM))
metadata <- read.csv(paste0(data_dir, "Meta_Data/TF_DP_Mata_Data_Renamed_Locations.csv"))
# basic line plot for chromosome chr1
chr <- "FaChr1P"
ggplot(nuc_div[CHROM==chr], aes(x=BIN_START, y=PI)) +
geom_line() +
labs(title=paste("Nucleotide diversity (pi) —", chr),
x="Genomic position (bp)", y="Pi")
# Summarize avrage pi in each chromosome
summary_pi <- nuc_div %>%
group_by(CHROM) %>%
summarise(mean_pi = mean(PI, na.rm = TRUE))
ggplot(summary_pi, aes(x = reorder(CHROM, mean_pi), y = mean_pi)) +
geom_col(fill = "darkgreen") +
coord_flip() +
theme_bw() +
labs(x = "Chromosome", y = "Mean π",
title = "Average Nucleotide Diversity Per Chromosome")
# Plots of each chromosme
chroms <- unique(nuc_div$CHROM)
# Set group size (how many chromosomes per plot)
group_size <- 3
# Loop through chromosomes in chunks
for (i in seq(1, length(chroms), by = group_size)) {
# Select subset of chromosomes
subset_chroms <- chroms[i:min(i + group_size - 1, length(chroms))]
# Filter data for this subset
plot_data <- filter(nuc_div, CHROM %in% subset_chroms)
# Create plot
p <- ggplot(plot_data, aes(x = BIN_START, y = PI)) +
geom_line(color = "steelblue") +
facet_wrap(~CHROM, scales = "free_x", ncol = 1) +
theme_bw() +
labs(
x = "Position (bp)",
y = "Nucleotide diversity (π)",
title = paste("Nucleotide diversity — Chromosomes", paste(subset_chroms, collapse = ", "))
)
# Display plot
print(p)
# Puase between plots
readline(prompt = "Press [Enter] to see next group...")
}
# basic line plot for chromosome chr1
chr <- "FaChr1P"
ggplot(nuc_div[CHROM==chr], aes(x=BIN_START, y=PI)) +
geom_line() +
labs(title=paste("Nucleotide diversity (pi) —", chr),
x="Genomic position (bp)", y="Pi")
# Read data
nuc_div <- fread(paste0(diversity_data, "diversity_results.windowed.pi"), header=TRUE)
# Keep only chromosomes of interest
nuc_div <- nuc_div %>% filter(grepl("FaChr", CHROM))
# Make sure chromosomes are ordered correctly
chrom_order <- unique(nuc_div$CHROM)
nuc_div$CHROM <- factor(nuc_div$CHROM, levels=chrom_order)
# Compute cumulative positions for Manhattan-style plotting
chrom_sizes <- nuc_div %>% group_by(CHROM) %>% summarise(max_pos=max(BIN_END))
chrom_offsets <- c(0, cumsum(head(chrom_sizes$max_pos, -1)))
names(chrom_offsets) <- chrom_sizes$CHROM
nuc_div <- nuc_div %>%
rowwise() %>%
mutate(cum_pos = BIN_START + chrom_offsets[as.character(CHROM)])
# Assign alternating colors for chromosomes
nuc_div$color <- as.factor(as.numeric(nuc_div$CHROM) %% 2)
ggplot(nuc_div, aes(x = cum_pos, y = PI, color = color)) +
geom_line() +
scale_color_manual(values = c("steelblue", "darkorange")) +
scale_x_continuous(labels = chrom_sizes$CHROM,
breaks = chrom_offsets + chrom_sizes$max_pos/2) +
labs(title = "Genome-wide nucleotide diversity (Pi)",
x = "Chromosome", y = "Pi") +
theme_classic() +
theme(legend.position = "none")
